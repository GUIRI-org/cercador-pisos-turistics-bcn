FROM mageai/mageai:0.9.79

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG PROJECT_NAME='mage-guiripisos'
ARG USER_CODE_PATH=/home/src/${PROJECT_NAME}
ARG USER_LOCAL='deploy'
# Must match the UID/GID that already owns the git checkout on the host
# (../magic/ and ../data/ are bind-mounted, so permissions come from there,
# not from the image). Check with `id <user>` on the server and set
# MAGE_UID/MAGE_GID in .env accordingly — do NOT chown files at runtime,
# that breaks `git reset --hard` on the next CI/CD deploy.
ARG USER_UID=1000
ARG USER_GID=1000

# Clone libraries
## Install git
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    apt-get autoremove -yqq --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add non-root user for Mage service with a fixed, predictable UID/GID
RUN addgroup --gid ${USER_GID} ${USER_LOCAL} && \
    adduser --disabled-password --gecos '' --uid ${USER_UID} --gid ${USER_GID} ${USER_LOCAL}

# Grant the user permissions to the Mage related directories
RUN mkdir /home/src/mage_data; chown -R ${USER_LOCAL} /home/src/mage_data
RUN mkdir ${USER_CODE_PATH}; chown -R ${USER_LOCAL} ${USER_CODE_PATH}

# Note: this overwrites the requirements.txt file in your new project on first run. 
# You can delete this line for the second run :) 
COPY magic/requirements.txt ${USER_CODE_PATH}/requirements.txt 

RUN pip3 install --no-cache-dir -r ${USER_CODE_PATH}/requirements.txt

# Set the user (matches the host's existing file owner — no chown at runtime)
USER ${USER_LOCAL}

ENV PYTHONPATH="${USER_CODE_PATH}:${PYTHONPATH}:/home/${USER_LOCAL}/.local/lib/python3.10/site-packages"

# Important: set back to the root folder
WORKDIR /home/src

CMD ["/bin/sh", "-c", "/app/run_app.sh"]