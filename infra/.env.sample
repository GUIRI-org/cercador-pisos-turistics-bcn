# =============================================================================
# GUIRIPISOS CONFIGURATION
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# See docs/deployment-blueprint.md for port allocation conventions.
#
# Container names are computed automatically from DOCKER_BASE_NAME:
#   - {DOCKER_BASE_NAME}-pgsql   (PostgreSQL)
#   - {DOCKER_BASE_NAME}-mage    (Mage.ai)
#   - {DOCKER_BASE_NAME}-api     (FastAPI)
#   - {DOCKER_BASE_NAME}-nginx   (Nginx)
#   - {DOCKER_BASE_NAME}-next    (Next.js, dev only)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Project Identity
# -----------------------------------------------------------------------------
## Base name for Docker containers and networks
DOCKER_BASE_NAME=guiripisos

## Docker Compose project name (shown in `docker compose ps`)
GLOBAL_INSTALLATION_APP=guiripisos

## Environment: production | staging | development | local
GLOBAL_ENV=development

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database
# -----------------------------------------------------------------------------
GLOBAL_DB_USER=postgres
GLOBAL_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
GLOBAL_DB_NAME=guiripisos

## External port for remote SQL client access (DBeaver, psql, etc.)
## Local dev: 5432 (default)
## Staging: 54{PROJECT_NUMBER} (e.g., 5401 for project 01)
## Production: 55{PROJECT_NUMBER} (e.g., 5501 for project 01)
GLOBAL_DB_EXTERNAL_PORT=5432

# -----------------------------------------------------------------------------
# 3. Nginx (Web Entry Point)
# -----------------------------------------------------------------------------
## Port exposed to host (HestiaCP proxies to this on server)
## Local dev: 8888 (or any available)
## Staging: 80{PROJECT_NUMBER} (e.g., 8001)
## Production: 81{PROJECT_NUMBER} (e.g., 8101)
NGINX_PORT=8888

## Domain configuration
## Local dev: use .local domains (add to /etc/hosts)
## Server: use actual domains configured in HestiaCP
MAIN_DOMAIN=guiripisos.local

# -----------------------------------------------------------------------------
# 4. Mage.ai (Data Pipelines)
# -----------------------------------------------------------------------------
## Port for Mage UI (internal, proxied via Nginx)
MAGE_PORT=6789

## Mage project directory name (under magic/)
MAGE_PROJECT_NAME=mage-guiripisos

## Authentication (optional)
REQUIRE_USER_AUTHENTICATION=1
DEFAULT_OWNER_EMAIL=admin@dev.com
DEFAULT_OWNER_PASSWORD=1234
DEFAULT_OWNER_NAME=Admin

# -----------------------------------------------------------------------------
# 5. API (FastAPI)
# -----------------------------------------------------------------------------
## Internal API port (proxied via Nginx)
API_PORT=8000

# -----------------------------------------------------------------------------
# 6. Frontend (Next.js) - Development only
# -----------------------------------------------------------------------------
## Next.js container name
NEXT_APP_CONTAINER_NAME=${DOCKER_BASE_NAME}-next

## Internal port for Next.js dev server
NEXT_APP_CONTAINER_PORT=3000

## API URL for the frontend to call
NEXT_APP_GUIRI_API_BASE=http://api.guiripisos.local:8888

# -----------------------------------------------------------------------------
# 7. Docker Settings (usually don't change)
# -----------------------------------------------------------------------------
## Platform for Docker images
## macOS Intel/M1/M2: linux/amd64
## ARM Linux: linux/arm64
DOCKER_PLATFORM=linux/amd64
