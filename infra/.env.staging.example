# =============================================================================
# GUIRIPISOS STAGING ENVIRONMENT
# =============================================================================
# Copy to: /opt/apps/guiripisos/staging/infra/.env
# =============================================================================

# Project Identity
DOCKER_BASE_NAME=guiripisos-staging
GLOBAL_INSTALLATION_APP=guiripisos-staging
GLOBAL_ENV=staging

# Database - Use strong passwords!
GLOBAL_DB_USER=guiripisos
GLOBAL_DB_PASSWORD=your-staging-db-password-here
GLOBAL_DB_NAME=guiripisos_staging
GLOBAL_DB_EXTERNAL_PORT=5401

# Nginx - Staging port 8001 (80 + project number 01)
NGINX_PORT=8001
MAIN_DOMAIN=stg.guiripisos.danielca.net

# Mage
MAGE_PORT=6789
MAGE_PROJECT_NAME=mage-guiripisos
REQUIRE_USER_AUTHENTICATION=1
DEFAULT_OWNER_EMAIL=admin@guiripisos.danielca.net
DEFAULT_OWNER_PASSWORD=change-this-password
DEFAULT_OWNER_NAME=Admin

# API
API_PORT=8000

# Frontend (dev only)
NEXT_APP_CONTAINER_PORT=3000
NEXT_APP_GUIRI_API_BASE=http://api.stg.guiripisos.danielca.net

# Docker
DOCKER_PLATFORM=linux/amd64
