# Copy this file to .env.local and adjust the values as needed

# Base URL for the GUIRI Apartments API
# Default: http://127.0.0.1:9092
NEXT_PUBLIC_GUIRI_API_BASE=http://127.0.0.1:9092

# Canonical base URL used for OGP metadata
# Default: https://elguiri.cat
NEXT_PUBLIC_SITE_URL=https://elguiri.cat

# Subfolder path for deployment (leave empty for root deploys)
# Example: /guiri-ptb
# Default: (empty)
NEXT_PUBLIC_BASE_PATH=
